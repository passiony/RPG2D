--- !u!114 &1277192839
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1277192836}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ec26b516f4165b40b72fec224244245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: "\u5C0F\u5973\u5B69"
  Tasks:
  - Name: "\u95EE\u5019"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: "Hello, traveller\uFF1FYou're dressed strangely. It doesn't feel like
        something a normal person would wear."
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: "What is your name\uFF1F"
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: '[name]'
        NextDialogIndex: 2
        Score: 0
    - Content: What a strange name. As strange as your person.
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: You look very young. How old are you?
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: '[age]'
        NextDialogIndex: 4
        Score: 0
    - Content: Ummm ...... doesn't look like that at all.
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u6C14\u7403\u4EFB\u52A1"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Well, I'd like to be your friend if you can help me take down my balloon
        .
      Speaker: Little Girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: You're so impolite.  I don't wanna help you.
        NextDialogIndex: 1
        Score: 0
      - Content: Ok..I will.
        NextDialogIndex: 2
        Score: 0
    - Content: Hmph, I don't think you can do it!
      Speaker: Little girl
      BreakType: 3
      Tag: Doesn't seem to have much patience for rude kids.
      Reward: 
      Choices: []
    - Content: Will you help me? Seems like you're not so bad!
      Speaker: Little girl
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u6CA1\u62FF\u5230\u6C14\u7403"
    m_Type: 0
    ItemId: balloon
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Haven't you got it yet?
      Speaker: Little Girl
      BreakType: 2
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u63D0\u4EA4\u6C14\u7403"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
