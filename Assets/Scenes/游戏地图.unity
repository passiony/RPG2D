--- !u!114 &1244027791
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1244027788}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ec26b516f4165b40b72fec224244245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Villagechief
  Tasks:
  - Name: "\u63A5\u53D7\u627E\u4FE1"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: My kid, I need you to find a letter for me. It should be around here
        somewhere.
      Speaker: Villagechief
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: Would you help me?
      Speaker: Villagechief
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Ok,I will help you.
        NextDialogIndex: 2
        Score: 0
      - Content: Just take time look for it, you can do it. right?
        NextDialogIndex: 3
        Score: 0
    - Content: Oh, would you? Thank you. I'll be waiting for you when you get back.
      Speaker: Villagechief
      BreakType: 1
      Tag: 
      Reward: 
      Choices: []
    - Content: Okay.. Yes, maybe i will ask for someone else.
      Speaker: Villagechief
      BreakType: 2
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u6CA1\u627E\u5230\u4FE1"
    m_Type: 0
    ItemId: Letter
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: You haven't found the letter yet? That's okay. Take your time. I'll
        wait for you.
      Speaker: Villagechief
      BreakType: 2
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u627E\u5230\u4E86\u4FE1"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: You found my letter!  Wait for me, after I put the stamp on it.
      Speaker: Villagechief
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: Could you please go back to the village entrance and mail away the
        letter for me? Thank you!
      Speaker: Villagechief
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Sorry,i have no time.
        NextDialogIndex: 2
        Score: 0
      - Content: "Yes\uFF0C my pleasure."
        NextDialogIndex: 3
        Score: 0
    - Content: It's okay. Just help me if you're free.
      Speaker: Villagechief
      BreakType: 2
      Tag: 
      Reward: 
      Choices: []
    - Content: So here's the stamped letter, the postbox is at the village gate ,
        please take care on your way.
      Speaker: Villagechief
      BreakType: 1
      Tag: 
      Reward: Stamped Letter
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u6CA1\u5BC4\u8D70\u4FE1"
    m_Type: 0
    ItemId: receipt
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Haven't found the post box yet? Yeah, it's a bit far away. That's
        okay, take your time.
      Speaker: Villagechief
      BreakType: 2
      Tag: 
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: "\u5BC4\u8D70\u4E86\u4FE1"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Thank you for sending my letter! It's such a bother for old people
        with bad legs, I'll remember you for being so kind to me.
      Speaker: Villagechief
      BreakType: 1
      Tag: Helped villagechief send the letter, his former comrade received it, and
        soon the Villagechief received a letter in return, he was very grateful.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  taskIndex: 0
  Score: 0
  failedTag: 
