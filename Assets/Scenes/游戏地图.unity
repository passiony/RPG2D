  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ec26b516f4165b40b72fec224244245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: BlackSmith
  Tasks:
  - Name: "\u95EE\u7B54"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Are you interested in my work? how about I ask you some interesting
        questions, kid?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: No...
        NextDialogIndex: -1
        Score: 0
      - Content: "OK\uFF01"
        NextDialogIndex: 1
        Score: 0
    - Content: What is the primary material used in the katana forging process?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Bronze
        NextDialogIndex: 2
        Score: 0
      - Content: ' Iron'
        NextDialogIndex: 2
        Score: 0
      - Content: Tamahagane
        NextDialogIndex: 2
        Score: 1
      - Content: Aluminum
        NextDialogIndex: 2
        Score: 0
    - Content: What is the purpose of folding the steel multiple times in traditional
        sword making?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Decorate the blade
        NextDialogIndex: 3
        Score: 0
      - Content: Remove impurities and create layers for strength
        NextDialogIndex: 3
        Score: 1
      - Content: Make the blade heavier
        NextDialogIndex: 3
        Score: 0
      - Content: Change the color of the steel
        NextDialogIndex: 3
        Score: 0
    - Content: During the forging process, what is the term for the point when the
        steel is heated to a high temperature and then rapidly cooled?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Tempering
        NextDialogIndex: 4
        Score: 0
      - Content: Annealing
        NextDialogIndex: 4
        Score: 0
      - Content: Quenching
        NextDialogIndex: 4
        Score: 1
      - Content: Normalizing
        NextDialogIndex: 4
        Score: 0
    - Content: What is the name of the technique used to create a hard edge and a
        softer spine on a sword?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: 'Differential hardening '
        NextDialogIndex: 5
        Score: 1
      - Content: ' Homogeneous hardening'
        NextDialogIndex: 5
        Score: 0
      - Content: Fullering
        NextDialogIndex: 5
        Score: 0
      - Content: Engraving
        NextDialogIndex: 5
        Score: 0
    - Content: What tool is typically used to shape the hot metal into a sword during
        the forging process?
      Speaker: BlackSmith
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Anvil
        NextDialogIndex: 6
        Score: 0
      - Content: Hammer
        NextDialogIndex: 6
        Score: 1
      - Content: Tongs
        NextDialogIndex: 6
        Score: 0
      - Content: Chisel
        NextDialogIndex: 6
        Score: 0
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 0-2
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 0-2
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: "You don't seem very interested.Never mind\uFF01"
      Speaker: BlackSmith
      BreakType: 3
      Tag: Doesn't seem to be much interest in  work of blacksmithing.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 3-4
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 3-4
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: 'It seems you know a lot! Well done!  '
      Speaker: BlackSmith
      BreakType: 3
      Tag: Seems to know a little about blacksmithing work.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 5
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 5-5
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: You got all the answers right! Are you interested in making weapons
        too? What a coincidence!
      Speaker: BlackSmith
      BreakType: 3
      Tag: Seems to know a lot about blacksmithing work.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  taskIndex: 0
  Score: 0
  failedTag: 
