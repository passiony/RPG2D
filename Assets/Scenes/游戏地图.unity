  m_Script: {fileID: 11500000, guid: 7ec26b516f4165b40b72fec224244245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: 
  Tasks:
  - Name: "\u6751\u957F\u7684\u7B14\u8BB0"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: You picked up a notebook.
      Speaker: 
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: take a look...
        NextDialogIndex: 1
        Score: 0
    - Content: 'Even though I defeated the Demon King and restored peace to the world
        years ago, I still feel a duty to guard it. That''s why, upon my return from
        the Demon World, I placed Excalibur back in the village and vowed to protect
        it until my dying breath. '
      Speaker: Village Chief's Notebook
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: It brings me joy to see young people becoming adventurers and embracing
        bravery as their guiding principle. I hope that someday in the future, if
        the world faces crisis again, a new adventurer will come here, draw Excalibur,
        and save the world.
      Speaker: Village Chief's Notebook
      BreakType: 1
      Tag: "\u6751\u957F\u7684\u7B14\u8BB0"
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  taskIndex: 0
  Score: 0
  failedTag: 
