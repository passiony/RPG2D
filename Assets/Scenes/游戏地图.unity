  m_Script: {fileID: 11500000, guid: 7ec26b516f4165b40b72fec224244245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Witch
  Tasks:
  - Name: "\u7B54\u9898"
    m_Type: 1
    ItemId: 
    GameId: 
    RewardId: 
    Score: 
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: 'I''m struggling with strange questions from occult books ...... '
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices: []
    - Content: Coming from a far country you might know these myths? Are you going
        to come and help me with these questions?
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: "Let's do it\uFF01"
        NextDialogIndex: 2
        Score: 0
      - Content: I am not interested in that.
        NextDialogIndex: -1
        Score: 0
    - Content: ' What is the name of Mario''s brother?'
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Luigi
        NextDialogIndex: 3
        Score: 1
      - Content: Wario
        NextDialogIndex: 3
        Score: 0
      - Content: Pipe
        NextDialogIndex: 3
        Score: 0
      - Content: John
        NextDialogIndex: 3
        Score: 0
    - Content: Who is the main character of The Legend of Zelda?
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Zelda
        NextDialogIndex: 4
        Score: 0
      - Content: Link
        NextDialogIndex: 4
        Score: 1
      - Content: Ganon
        NextDialogIndex: 4
        Score: 0
      - Content: Hilda
        NextDialogIndex: 4
        Score: 0
    - Content: What is the name of the main character in Final Fantasy VII?
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: ' Cloud Strife'
        NextDialogIndex: 5
        Score: 1
      - Content: Tifa Lockhart
        NextDialogIndex: 5
        Score: 0
      - Content: Sephiroth
        NextDialogIndex: 5
        Score: 0
      - Content: Vincent Valentine
        NextDialogIndex: 5
        Score: 0
    - Content: Which character is known as the Lich King?
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Arthas Menethil
        NextDialogIndex: 6
        Score: 1
      - Content: Illidan Stormrage
        NextDialogIndex: 6
        Score: 0
      - Content: Targor
        NextDialogIndex: 6
        Score: 0
      - Content: Kel'Thuzad
        NextDialogIndex: 6
        Score: 0
    - Content: The Nether Portal using which type of block?
      Speaker: Witch
      BreakType: 0
      Tag: 
      Reward: 
      Choices:
      - Content: Bedrock
        NextDialogIndex: 7
        Score: 0
      - Content: 'Obsidian '
        NextDialogIndex: 7
        Score: 1
      - Content: End Stone
        NextDialogIndex: 7
        Score: 0
      - Content: Lava
        NextDialogIndex: 7
        Score: 0
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 0-2
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 0-2
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Is that really true? Well, I'll look into it a bit more, thank you.
      Speaker: Witch
      BreakType: 3
      Tag: Doesn't seem to know much about legends from other worlds.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 3-4
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 3-4
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: Seems like you from a faraway land really know something ...... Thank
        you, I'll keep working on the content.
      Speaker: Witch
      BreakType: 3
      Tag: Seems  know something about legends from other worlds.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  - Name: 5
    m_Type: 4
    ItemId: 
    GameId: 
    RewardId: 
    Score: 5-5
    BranchName: 
    Branchs: []
    Dialogues:
    - Content: You seem to be saying exactly what I presumed ...... is awesome! Thank
        you, my research seems to be coming along nicely! You seem to know a lot
        about this!
      Speaker: Witch
      BreakType: 3
      Tag: Seems  know a lot about otherworld legends.
      Reward: 
      Choices: []
    OnFinish:
      m_PersistentCalls:
        m_Calls: []
  taskIndex: 0
  Score: 0
  failedTag: Took the doctor's commission but did not deliver the item. The doctor
    had been very concerned about whether traveler were in some kind of trouble.
